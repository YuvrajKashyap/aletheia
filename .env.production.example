APP_NAME=aletheia
APP_MODE=production
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
RQ_DEFAULT_QUEUE=default
WORKER_NAME=aletheia-worker

OPENSEARCH_URL=https://OPENSEARCH_HOST
OPENSEARCH_USERNAME=replace-me-if-managed
OPENSEARCH_PASSWORD=replace-me-if-managed
OPENSEARCH_VERIFY_CERTS=true

QDRANT_URL=https://QDRANT_HOST
QDRANT_API_KEY=replace-me-if-managed

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
MODEL_CACHE_DIR=/tmp/aletheia-models
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

ADMIN_API_KEY=replace-with-real-secret
CORS_ALLOWED_ORIGINS=https://aletheia.yuvrajkashyap.com
